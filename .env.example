# Job Intelligence Platform — Environment Variables
# Copy to .env and fill in real values before starting.

# Application
APP_NAME="Job Intelligence Platform"
ENVIRONMENT=development
DEBUG=true
API_V1_STR=/api/v1

# SECRET_KEY — generate a strong random key for production:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=<GENERATE_A_RANDOM_SECRET_KEY>
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL 16)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=jobuser
POSTGRES_PASSWORD=<SET_A_STRONG_DB_PASSWORD>
POSTGRES_DB=job_intelligence_db
# DATABASE_URL and SYNC_DATABASE_URL are auto-constructed from the above components.
# Override only if you need a fully custom connection string:
# DATABASE_URL=postgresql+asyncpg://jobuser:<password>@localhost:5432/job_intelligence_db
# SYNC_DATABASE_URL=postgresql+psycopg2://jobuser:<password>@localhost:5432/job_intelligence_db

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Scraping Engine Defaults
SCRAPE_REQUEST_TIMEOUT=15
SCRAPE_REQUEST_DELAY=1.5
SCRAPE_MAX_PAGES=5
PLAYWRIGHT_HEADLESS=true

# CORS Configuration (JSON List format or comma separated)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Webhook & Notifications
DEFAULT_WEBHOOK_URL=
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=notifications@jobintelligence.io
EMAILS_FROM_NAME="Job Intelligence Platform"

# Development-only: Demo account seeding (leave blank in production)
# These passwords are used to create admin/candidate accounts on first startup
# when ENVIRONMENT=development. Set them to any strong password you choose.
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=
