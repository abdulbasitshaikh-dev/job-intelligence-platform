# Job Intelligence Platform Environment Variables

# Application
APP_NAME="Job Intelligence Platform"
ENVIRONMENT=development
DEBUG=true
API_V1_STR=/api/v1
SECRET_KEY=09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL 16)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=jobuser
POSTGRES_PASSWORD=jobpassword
POSTGRES_DB=job_intelligence_db
DATABASE_URL=postgresql+asyncpg://jobuser:jobpassword@localhost:5432/job_intelligence_db
SYNC_DATABASE_URL=postgresql+psycopg2://jobuser:jobpassword@localhost:5432/job_intelligence_db

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Scraping Engine Defaults
SCRAPE_REQUEST_TIMEOUT=15
SCRAPE_REQUEST_DELAY=1.5
SCRAPE_MAX_PAGES=5
PLAYWRIGHT_HEADLESS=true

# CORS Configuration (JSON List format or comma separated)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Webhook & Notifications
DEFAULT_WEBHOOK_URL=http://localhost:5678/webhook/job-events
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@example.com
SMTP_PASSWORD=secretpassword
EMAILS_FROM_EMAIL=notifications@jobintelligence.io
EMAILS_FROM_NAME="Job Intelligence Platform"
